<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/streaming-ontology#"
     xml:base="http://www.semanticweb.org/streaming-ontology"
     xmlns:so="http://www.semanticweb.org/streaming-ontology#"
     xmlns:dbo="http://dbpedia.org/ontology/"
     xmlns:dbp="http://dbpedia.org/property/"
     xmlns:dbr="http://dbpedia.org/resource/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/streaming-ontology">
        <rdfs:comment xml:lang="en">An ontology designed to model the streaming domain, capturing audiovisual content, streaming platform availability, user viewing behavior and preferences, content ratings, and simple recommendation logic.</rdfs:comment>
        <rdfs:label xml:lang="en">Streaming Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/streaming-ontology#PercentageValue -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/streaming-ontology#PercentageValue">
        <rdfs:comment xml:lang="en">Custom datatype for decimal percentage values in [0.00, 100.00] with a maximum of 2 fractional digits. Used for completionPercentage.</rdfs:comment>
        <rdfs:label xml:lang="en">Percentage Value</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.00</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://www.semanticweb.org/streaming-ontology#RatingValue -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/streaming-ontology#RatingValue">
        <rdfs:comment xml:lang="en">Custom datatype for decimal rating values in [0.0, 10.0] with a maximum of 1 fractional digit. Used for ratingValue.</rdfs:comment>
        <rdfs:label xml:lang="en">Rating Value</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/streaming-ontology#availabilityOfContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityOfContent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasAvailability"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Functional. Relates a content availability record to the single content item it concerns. Inverse of hasAvailability.</rdfs:comment>
        <rdfs:label xml:lang="en">availability of content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#availableInCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availableInCountry">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="https://schema.org/Country"/>
        <rdfs:comment xml:lang="en">Relates a content availability record to the geographic country where the content is available.</rdfs:comment>
        <rdfs:label xml:lang="en">available in country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#availableOnPlatform -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availableOnPlatform">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#offersAvailability"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:comment xml:lang="en">Functional. Relates a content availability record to the streaming platform it pertains to.</rdfs:comment>
        <rdfs:label xml:lang="en">available on platform</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#directed -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#directed">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasDirector"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasDirector. Relates a director to the content they directed.</rdfs:comment>
        <rdfs:label xml:lang="en">directed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:comment xml:lang="en">Functional. Relates a watch-later entry to the list it belongs to. Inverse of hasWatchLaterEntry.</rdfs:comment>
        <rdfs:label xml:lang="en">entry in watch later list</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#episodeOfSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeOfSeason">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:comment xml:lang="en">Functional. Relates an episode to the season it belongs to. Inverse of hasSeasonEpisode.</rdfs:comment>
        <rdfs:label xml:lang="en">episode of season</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasActingRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasActingRole">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#roleInContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a reified acting role performed within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has acting role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasAvailability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasAvailability">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a reified availability record on a platform.</rdfs:comment>
        <rdfs:label xml:lang="en">has availability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasBeenViewedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasBeenViewedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:comment xml:lang="en">Inverse of viewedContent. Relates audiovisual content to the viewing events in which it was watched.</rdfs:comment>
        <rdfs:label xml:lang="en">has been viewed in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasDirector">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/director"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its director. Subproperty of schema:director.</rdfs:comment>
        <rdfs:label xml:lang="en">has director</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasGenre">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/genre"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isGenreOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its genre. Subproperty of schema:genre.</rdfs:comment>
        <rdfs:label xml:lang="en">has genre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasMetadataContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasMetadataContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Functional. Relates an audiovisual content item to the single content item that carries its descriptive metadata (acting roles, director, genre). For an episode this is its parent series; for a series or a film it is the item itself. Asserted directly on each content item, so per-episode metadata does not need to be repeated.</rdfs:comment>
        <rdfs:label xml:lang="en">has metadata content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasOriginalLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasOriginalLanguage">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="https://schema.org/Language"/>
        <rdfs:comment xml:lang="en">Functional. Relates audiovisual content to its original language.</rdfs:comment>
        <rdfs:label xml:lang="en">has original language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredActor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule PreferredActor. Relates a user to the actors they prefer, based on repeated high-completion viewings.</rdfs:comment>
        <rdfs:label xml:lang="en">has preferred actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredDirector">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule PreferredDirector. Relates a user to the directors they prefer, based on repeated high-completion viewings.</rdfs:comment>
        <rdfs:label xml:lang="en">has preferred director</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule PreferredGenre. Relates a user to the genres they prefer, based on repeated high-completion viewings.</rdfs:comment>
        <rdfs:label xml:lang="en">has preferred genre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasProducer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProducer">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/producer"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#produced"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Producer"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its producer. Subproperty of schema:producer.</rdfs:comment>
        <rdfs:label xml:lang="en">has producer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasProductionCompany -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProductionCompany">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/productionCompany"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#producesContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCompany"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to the company that produced it. Subproperty of schema:productionCompany.</rdfs:comment>
        <rdfs:label xml:lang="en">has production company</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasProductionCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProductionCountry">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/countryOfOrigin"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isProductionCountryOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="https://schema.org/Country"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its country of production. Subproperty of schema:countryOfOrigin.</rdfs:comment>
        <rdfs:label xml:lang="en">has production country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasReceivedRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasReceivedRating">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:comment xml:lang="en">Inverse of ratesContent. Relates audiovisual content to user rating records it has received.</rdfs:comment>
        <rdfs:label xml:lang="en">has received rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasScreenwriter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasScreenwriter">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/creator"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Screenwriter"/>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its screenwriter. Subproperty of schema:creator.</rdfs:comment>
        <rdfs:label xml:lang="en">has screenwriter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeason">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containsSeason"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonOfSeries"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:comment xml:lang="en">Relates a TV series to the seasons it contains. Subproperty of schema:containsSeason. Inverse of seasonOfSeries.</rdfs:comment>
        <rdfs:label xml:lang="en">has season</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/episode"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:comment xml:lang="en">Relates a TV season to its episodes. Subproperty of schema:episode. Inverse of episodeOfSeason.</rdfs:comment>
        <rdfs:label xml:lang="en">has season episode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasUserRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasUserRating">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:comment xml:lang="en">Relates a user to the ratings they have submitted.</rdfs:comment>
        <rdfs:label xml:lang="en">has user rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasViewingEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasViewingEvent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedByUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:comment xml:lang="en">Relates a user to their viewing events.</rdfs:comment>
        <rdfs:label xml:lang="en">has viewing event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:comment xml:lang="en">Relates a watch-later list to its entries.</rdfs:comment>
        <rdfs:label xml:lang="en">has watch later entry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchLaterList -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterList">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterListOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:comment xml:lang="en">Functional. Relates a user to their single watch-later list.</rdfs:comment>
        <rdfs:label xml:lang="en">has watch later list</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#isGenreOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isGenreOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasGenre. Relates a genre to the audiovisual content belonging to it.</rdfs:comment>
        <rdfs:label xml:lang="en">is genre of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf">
        <rdfs:domain rdf:resource="https://schema.org/Language"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasOriginalLanguage. Relates a language to content for which it is the original language.</rdfs:comment>
        <rdfs:label xml:lang="en">is original language of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#isProductionCountryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isProductionCountryOf">
        <rdfs:domain rdf:resource="https://schema.org/Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasProductionCountry. Relates a country to the content produced there.</rdfs:comment>
        <rdfs:label xml:lang="en">is production country of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#offersAvailability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#offersAvailability">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:comment xml:lang="en">Inverse of availableOnPlatform. Relates a streaming platform to its content availability records.</rdfs:comment>
        <rdfs:label xml:lang="en">offers availability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#performedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#performedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#performsRole"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:comment xml:lang="en">Functional. Relates an acting role to the single actor who performs it. Inverse of performsRole.</rdfs:comment>
        <rdfs:label xml:lang="en">performed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#performsRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#performsRole">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:comment xml:lang="en">Inverse of performedBy. Relates an actor to an acting role they perform.</rdfs:comment>
        <rdfs:label xml:lang="en">performs role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#portrayedInRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#portrayedInRole">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#portraysCharacter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:comment xml:lang="en">Inverse of portraysCharacter. Relates a character to the acting role that portrays it.</rdfs:comment>
        <rdfs:label xml:lang="en">portrayed in role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#portraysCharacter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#portraysCharacter">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:comment xml:lang="en">Functional. Relates an acting role to the character it portrays.</rdfs:comment>
        <rdfs:label xml:lang="en">portrays character</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#produced -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#produced">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Producer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasProducer. Relates a producer to the content they produced.</rdfs:comment>
        <rdfs:label xml:lang="en">produced</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#producesContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#producesContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCompany"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasProductionCompany. Relates a production company to the content it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">produces content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ratesContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratesContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Functional. Relates a rating record to the audiovisual content item being rated.</rdfs:comment>
        <rdfs:label xml:lang="en">rates content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ratingByUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingByUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:comment xml:lang="en">Functional. Relates a rating to the user who submitted it. Inverse of hasUserRating.</rdfs:comment>
        <rdfs:label xml:lang="en">rating by user</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#roleInContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#roleInContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Functional. Relates a reified acting role to the single content item in which it occurs. Inverse of hasActingRole.</rdfs:comment>
        <rdfs:label xml:lang="en">role in content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#seasonOfSeries -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#seasonOfSeries">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:comment xml:lang="en">Functional. Relates a TV season to its parent TV series. Inverse of hasSeason.</rdfs:comment>
        <rdfs:label xml:lang="en">season of series</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#suggestedActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedActor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule RecommendActor. Relates a user to actors recommended on the basis of their high ratings.</rdfs:comment>
        <rdfs:label xml:lang="en">suggested actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#suggestedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule RecommendContent. Relates a user to content items recommended for thematic continuity (same director and genre as completed content).</rdfs:comment>
        <rdfs:label xml:lang="en">suggested content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#suggestedGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:comment xml:lang="en">Inferred property — populated exclusively by the SWRL rule RecommendGenre. Relates a user to genres recommended on the basis of their high ratings.</rdfs:comment>
        <rdfs:label xml:lang="en">suggested genre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#viewedByUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewedByUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:comment xml:lang="en">Functional. Relates a viewing event to the user who initiated it. Inverse of hasViewingEvent.</rdfs:comment>
        <rdfs:label xml:lang="en">viewed by user</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#viewedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewedContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Movie"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Functional. Relates a viewing event to the single content item that was viewed. Range restricted to Movie or TVEpisode: viewing events always refer to directly watchable items; their descriptive metadata is reached through hasMetadataContent.</rdfs:comment>
        <rdfs:label xml:lang="en">viewed content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Functional. Relates a watch-later entry to the audiovisual content it references.</rdfs:comment>
        <rdfs:label xml:lang="en">watch later content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterListOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterListOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:comment xml:lang="en">Functional and inverse-functional. Relates a watch-later list to its owner user. Inverse of hasWatchLaterList.</rdfs:comment>
        <rdfs:label xml:lang="en">watch later list of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Screenwriter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:comment xml:lang="en">Inverse of hasScreenwriter. Relates a screenwriter to the content they wrote.</rdfs:comment>
        <rdfs:label xml:lang="en">wrote screenplay for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/containsSeason -->

    <owl:ObjectProperty rdf:about="https://schema.org/containsSeason"/>
    


    <!-- https://schema.org/countryOfOrigin -->

    <owl:ObjectProperty rdf:about="https://schema.org/countryOfOrigin"/>
    


    <!-- https://schema.org/creator -->

    <owl:ObjectProperty rdf:about="https://schema.org/creator"/>
    


    <!-- https://schema.org/director -->

    <owl:ObjectProperty rdf:about="https://schema.org/director"/>
    


    <!-- https://schema.org/episode -->

    <owl:ObjectProperty rdf:about="https://schema.org/episode"/>
    


    <!-- https://schema.org/genre -->

    <owl:ObjectProperty rdf:about="https://schema.org/genre"/>
    


    <!-- https://schema.org/producer -->

    <owl:ObjectProperty rdf:about="https://schema.org/producer"/>
    


    <!-- https://schema.org/productionCompany -->

    <owl:ObjectProperty rdf:about="https://schema.org/productionCompany"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional. The date and time when the content was added to the watch-later list.</rdfs:comment>
        <rdfs:label xml:lang="en">added to watch later on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#availabilityEndDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityEndDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional, optional. The date and time at which the content ceases to be available on a platform.</rdfs:comment>
        <rdfs:label xml:lang="en">availability end date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#availabilityStartDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityStartDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional. The date and time from which the content becomes available on a platform.</rdfs:comment>
        <rdfs:label xml:lang="en">availability start date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#birthDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#birthDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Functional, optional. The date of birth of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">birth date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#characterName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#characterName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Functional. The name of a fictional or represented character.</rdfs:comment>
        <rdfs:label xml:lang="en">character name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#completionPercentage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#completionPercentage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#PercentageValue"/>
        <rdfs:comment xml:lang="en">Functional. The percentage of the content item watched (0–100 inclusive, at most 2 fractional digits).</rdfs:comment>
        <rdfs:label xml:lang="en">completion percentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#contentDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#contentDuration">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/duration"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Functional. The runtime duration of an audiovisual content item. Aligned with schema:duration.</rdfs:comment>
        <rdfs:label xml:lang="en">content duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#description -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#description">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Optional free-text description of a domain entity.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#entityName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#entityName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Functional. At most one preferred local name for a domain entity. Supports application data in addition to rdfs:label.</rdfs:comment>
        <rdfs:label xml:lang="en">entity name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#episodeNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Functional. The ordinal number of a TV episode within its season.</rdfs:comment>
        <rdfs:label xml:lang="en">episode number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#externalIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#externalIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Optional external identifier (e.g., IMDb ID, DBpedia IRI) for a domain entity.</rdfs:comment>
        <rdfs:label xml:lang="en">external identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ratingComment -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingComment">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Optional. A free-text comment accompanying the user rating.</rdfs:comment>
        <rdfs:label xml:lang="en">rating comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ratingDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional, exactly one. The date and time when the rating was submitted.</rdfs:comment>
        <rdfs:label xml:lang="en">rating date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ratingValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingValue">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/ratingValue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#RatingValue"/>
        <rdfs:comment xml:lang="en">Functional, exactly one. A decimal score in [0.0, 10.0] representing the user&apos;s rating (maximum one fractional digit).</rdfs:comment>
        <rdfs:label xml:lang="en">rating value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#registrationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#registrationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional. The date and time when the user registered on the platform.</rdfs:comment>
        <rdfs:label xml:lang="en">registration date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#releaseDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#releaseDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Functional, optional. The original release date of an audiovisual content item.</rdfs:comment>
        <rdfs:label xml:lang="en">release date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#seasonNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#seasonNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Functional. The ordinal number of a TV season within its series.</rdfs:comment>
        <rdfs:label xml:lang="en">season number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#title -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#title">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Functional. The title of an audiovisual content item.</rdfs:comment>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#userIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#userIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Functional. A unique identifier string for a user (e.g., username or account ID).</rdfs:comment>
        <rdfs:label xml:lang="en">user identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#viewingDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewingDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Functional, exactly one. The date and time when the viewing event occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">viewing date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#viewingDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewingDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Functional, exactly one. The total duration of the viewing session.</rdfs:comment>
        <rdfs:label xml:lang="en">viewing duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterPosition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Functional, optional. The ordinal position of an entry within a watch-later list.</rdfs:comment>
        <rdfs:label xml:lang="en">watch later position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/dateCreated -->

    <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated"/>
    


    <!-- https://schema.org/duration -->

    <owl:DatatypeProperty rdf:about="https://schema.org/duration"/>
    


    <!-- https://schema.org/ratingValue -->

    <owl:DatatypeProperty rdf:about="https://schema.org/ratingValue"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/streaming-ontology#ActingRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ActingRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#performedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#portraysCharacter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#roleInContent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A reified participation node connecting a performer, a character, and an audiovisual content item to capture role details.</rdfs:comment>
        <rdfs:label xml:lang="en">Acting Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Actor -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Actor">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A person who performs an acting role in audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#AudiovisualContent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#AudiovisualContent">
        <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#releaseDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Movie"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Any audiovisual work available or potentially available through streaming. Root class of the content hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="en">Audiovisual Content</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Character -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Character">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A fictional or represented character appearing in audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Character</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/streaming-ontology#PartialViewingEvent"/>
        <rdfs:comment xml:lang="en">Inferred class: populated exclusively by SWRL rules. A viewing event that occurs when content is viewed and is considered completed.</rdfs:comment>
        <rdfs:label xml:lang="en">Completed Viewing Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ContentAvailability -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentAvailability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityOfContent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availableOnPlatform"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityStartDate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityEndDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A reified record describing the time-bounded availability of an audiovisual content item on a specific streaming platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Content Availability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ContentCompleter -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentCompleter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:comment xml:lang="en">Inferred class — populated exclusively by SWRL rules. A user who has completed at least one content item fully.</rdfs:comment>
        <rdfs:label xml:lang="en">Content Completer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Director -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Director">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A person who directs audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Director</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#DomainEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#DomainEntity">
        <rdfs:comment xml:lang="en">Base class for ontology entities.</rdfs:comment>
        <rdfs:label xml:lang="en">Domain Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Genre -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Genre">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:comment xml:lang="en">A category of audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Genre</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#HighlyEngagedUser -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#HighlyEngagedUser">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:comment xml:lang="en">Inferred class — populated exclusively by SWRL rules. A user who is highly engaged.</rdfs:comment>
        <rdfs:label xml:lang="en">Highly Engaged User</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Movie -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Movie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Movie"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#contentDuration"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A feature-length or standalone film available through streaming.</rdfs:comment>
        <rdfs:label xml:lang="en">Movie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#PartialViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#PartialViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:comment xml:lang="en">Inferred class: populated exclusively by SWRL rules. A viewing event that occurs when content is viewed and is considered not completed.</rdfs:comment>
        <rdfs:label xml:lang="en">Partial Viewing Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Producer -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Producer">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A person responsible for producing audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Producer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ProductionCompany -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ProductionCompany">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">An organization that produces audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Production Company</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#Screenwriter -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Screenwriter">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A person who writes the screenplay for audiovisual content.</rdfs:comment>
        <rdfs:label xml:lang="en">Screenwriter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#StreamingPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#StreamingPlatform">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">A service offering streamed audiovisual content to subscribers.</rdfs:comment>
        <rdfs:label xml:lang="en">Streaming Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#TVEpisode -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVEpisode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVEpisode"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOfSeason"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeNumber"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#contentDuration"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An episode belonging to a TV season.</rdfs:comment>
        <rdfs:label xml:lang="en">TV Episode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#TVSeason -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeason">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVSeason"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonOfSeries"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonNumber"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A season belonging to a TV series, containing one or more episodes.</rdfs:comment>
        <rdfs:label xml:lang="en">TV Season</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#TVSeries -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeries">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVSeries"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeason"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A television series composed of one or more seasons.</rdfs:comment>
        <rdfs:label xml:lang="en">TV Series</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#User -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#User">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:comment xml:lang="en">A registered user of one or more streaming platforms.</rdfs:comment>
        <rdfs:label xml:lang="en">User</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#UserRating -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#UserRating">
        <rdfs:subClassOf rdf:resource="https://schema.org/Rating"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingDate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.semanticweb.org/streaming-ontology#RatingValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingComment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="en">A rating event submitted by a user for a specific audiovisual content item.</rdfs:comment>
        <rdfs:label xml:lang="en">User Rating</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#ViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedByUser"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.semanticweb.org/streaming-ontology#PercentageValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewingDate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewingDuration"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A single occurrence of a user watching an audiovisual content item, recording date, duration and completion percentage.</rdfs:comment>
        <rdfs:label xml:lang="en">Viewing Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#WatchLaterEntry -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterContent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterPosition"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterContent"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="en">A dated entry in a watch-later list, linking a specific content item with a timestamp and optional ordering position.</rdfs:comment>
        <rdfs:label xml:lang="en">Watch Later Entry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/streaming-ontology#WatchLaterList -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterList">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterListOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A user-owned ordered collection of audiovisual content items saved for later viewing.</rdfs:comment>
        <rdfs:label xml:lang="en">Watch Later List</rdfs:label>
    </owl:Class>
    


