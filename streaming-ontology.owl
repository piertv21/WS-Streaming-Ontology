    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Infers hasPreferredGenre for a user if they have viewed at least 5 contents of a certain genre and all have a completionPercentage &gt;= 80.</rdfs:comment>
        <rdfs:label>PreferredGenre</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
