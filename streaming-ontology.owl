<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/streaming-ontology#"
     xml:base="http://www.semanticweb.org/streaming-ontology"
     xmlns:so="http://www.semanticweb.org/streaming-ontology#"
     xmlns:schema="https://schema.org/"
     xmlns:dbo="http://dbpedia.org/ontology/"
     xmlns:dbr="http://dbpedia.org/resource/"
     xmlns:dbp="http://dbpedia.org/property/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/streaming-ontology">
        <rdfs:label xml:lang="en">Streaming Platforms Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">An ontology for audiovisual content, streaming platforms, viewing behavior, user preferences, ratings, and recommendations.</rdfs:comment>
    </owl:Ontology>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- ==================== Content contributor properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasContributor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasContributor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#contributedTo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="https://schema.org/Person"/>
        <rdfs:label xml:lang="en">has contributor</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a person who contributed to its creation in any role.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#contributedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#contributedTo">
        <rdfs:domain rdf:resource="https://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">contributed to</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasContributor. Relates a person to audiovisual content they contributed to.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasActor">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasContributor"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/actor"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#actedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">has actor</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to an actor who performed in it. Subproperty of hasContributor and schema:actor.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#actedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#actedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">acted in</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasActor. Relates an actor to the audiovisual content they performed in.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasVoiceActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasVoiceActor">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasActor"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#voiceActedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#VoiceActor"/>
        <rdfs:label xml:lang="en">has voice actor</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a voice actor who provided a voice performance.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#voiceActedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#voiceActedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#VoiceActor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">voice acted in</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasVoiceActor. Relates a voice actor to the content they voiced.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasDirector">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasContributor"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/director"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#directed"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:label xml:lang="en">has director</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its director. Subproperty of hasContributor and schema:director.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#directed -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#directed">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">directed</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasDirector. Relates a director to the content they directed.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasProducer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProducer">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasContributor"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#produced"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Producer"/>
        <rdfs:label xml:lang="en">has producer</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its producer. Subproperty of hasContributor.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#produced -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#produced">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Producer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">produced</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasProducer. Relates a producer to the content they produced.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasScreenwriter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasScreenwriter">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasContributor"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/creator"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Screenwriter"/>
        <rdfs:label xml:lang="en">has screenwriter</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its screenwriter. Subproperty of hasContributor and schema:creator.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#wroteScreenplayFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Screenwriter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">wrote screenplay for</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasScreenwriter. Relates a screenwriter to the content they wrote.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Acting-role properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasActingRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasActingRole">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#roleInContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:label xml:lang="en">has acting role</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a reified acting role performed within it.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#roleInContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#roleInContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">role in content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a reified acting role to the single content item in which it occurs. Inverse of hasActingRole.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#performedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#performedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#performsRole"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">performed by</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an acting role to the single actor who performs it. Inverse of performsRole.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#performsRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#performsRole">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:label xml:lang="en">performs role</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of performedBy. Relates an actor to an acting role they perform.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#portraysCharacter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#portraysCharacter">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#portrayedInRole"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:label xml:lang="en">portrays character</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an acting role to the character it portrays.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#portrayedInRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#portrayedInRole">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:label xml:lang="en">portrayed in role</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of portraysCharacter. Relates a character to the acting role that portrays it.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Series-structure properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeason">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containsSeason"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonOfSeries"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:label xml:lang="en">has season</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a TV series to the seasons it contains. Subproperty of schema:containsSeason. Inverse of seasonOfSeries.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#seasonOfSeries -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#seasonOfSeries">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:label xml:lang="en">season of series</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a TV season to its parent TV series. Inverse of hasSeason.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasEpisode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasEpisode">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/episode"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:label xml:lang="en">has episode</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a TV series or TV season to its episodes. Subproperty of schema:episode. Inverse of episodeOf.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#episodeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:label xml:lang="en">episode of</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasEpisode. Relates an episode to the series or season it belongs to.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasEpisode"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOfSeason"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:label xml:lang="en">has season episode</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a TV season to its episodes. Subproperty of hasEpisode. Inverse of episodeOfSeason.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#episodeOfSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeOfSeason">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:label xml:lang="en">episode of season</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an episode to the season it belongs to. Inverse of hasSeasonEpisode.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasSeriesEpisode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeriesEpisode">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasEpisode"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOfSeries"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeason"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:label xml:lang="en">has series episode</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a TV series directly to its episodes. Subproperty of hasEpisode. Inverse of episodeOfSeries. Inferred via chain: hasSeason o hasSeasonEpisode.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#episodeOfSeries -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeOfSeries">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:label xml:lang="en">episode of series</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an episode to the TV series it belongs to. Inverse of hasSeriesEpisode.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Classification and production properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasGenre">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isGenreOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">has genre</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its genre. Aligned with schema:genre.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isGenreOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isGenreOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">is genre of</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasGenre. Relates a genre to the audiovisual content belonging to it.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasProductionCompany -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProductionCompany">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/productionCompany"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#producesContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCompany"/>
        <rdfs:label xml:lang="en">has production company</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to the company that produced it. Subproperty of schema:productionCompany.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#producesContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#producesContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCompany"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">produces content</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasProductionCompany. Relates a production company to the content it produces.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasProductionCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasProductionCountry">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/countryOfOrigin"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isProductionCountryOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCountry"/>
        <rdfs:label xml:lang="en">has production country</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to its country of production. Subproperty of schema:countryOfOrigin.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isProductionCountryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isProductionCountryOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCountry"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">is production country of</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasProductionCountry. Relates a production country to the content produced there.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasOriginalLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasOriginalLanguage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentLanguage"/>
        <rdfs:label xml:lang="en">has original language</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates audiovisual content to its original language. Functionally specialized alignment of schema:inLanguage.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isOriginalLanguageOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentLanguage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">is original language of</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasOriginalLanguage. Relates a language to content for which it is the original language.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasAvailableLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasAvailableLanguage">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isAvailableLanguageOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentLanguage"/>
        <rdfs:label xml:lang="en">has available language</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to languages available for playback (audio, subtitles, etc.).</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isAvailableLanguageOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isAvailableLanguageOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentLanguage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">is available language of</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasAvailableLanguage. Relates a language to content for which it is available for playback.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Availability properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasAvailability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasAvailability">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityOfContent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:label xml:lang="en">has availability</rdfs:label>
        <rdfs:comment xml:lang="en">Relates audiovisual content to a reified availability record on a platform.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#availabilityOfContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityOfContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">availability of content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a content availability record to the single content item it concerns. Inverse of hasAvailability.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#availableOnPlatform -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availableOnPlatform">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#offersAvailability"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:label xml:lang="en">available on platform</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a content availability record to the streaming platform it pertains to.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#offersAvailability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#offersAvailability">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#offersAvailability"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityOfContent"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:label xml:lang="en">offers availability</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of availableOnPlatform. Relates a streaming platform to its content availability records.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#availableInCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availableInCountry">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ProductionCountry"/>
        <rdfs:label xml:lang="en">available in country</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a content availability record to the geographic country where the content is available.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasAvailableContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasAvailableContent">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#offersAvailability"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityOfContent"/>
        </owl:propertyChainAxiom>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#isAvailableOn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">has available content</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred summary property. Relates a streaming platform to the audiovisual content available on it. Inferred via chain: offersAvailability o availabilityOfContent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isAvailableOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isAvailableOn">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasAvailability"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#availableOnPlatform"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
        <rdfs:label xml:lang="en">is available on</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred summary property. Relates audiovisual content to the streaming platforms where it is available. Inferred via chain: hasAvailability o availableOnPlatform. Inverse of hasAvailableContent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Viewing-history properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasViewingEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasViewingEvent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedByUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:label xml:lang="en">has viewing event</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a user to their viewing events.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#viewedByUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewedByUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">viewed by user</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a viewing event to the user who initiated it. Inverse of hasViewingEvent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#viewedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewedContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasBeenViewedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">viewed content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a viewing event to the single audiovisual content item that was viewed.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasBeenViewedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasBeenViewedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:label xml:lang="en">has been viewed in</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of viewedContent. Relates audiovisual content to the viewing events in which it was watched.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchedContent">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
        </owl:propertyChainAxiom>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#watchedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">has watched content</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred summary relation. Relates a user to the audiovisual content they have watched. Inferred via chain: hasViewingEvent o viewedContent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#watchedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">watched by</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of hasWatchedContent. Relates audiovisual content to the users who have watched it.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Watch-later properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchLaterList -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterList">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterListOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:label xml:lang="en">has watch later list</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a user to their single watch-later list.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterListOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterListOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">watch later list of</rdfs:label>
        <rdfs:comment xml:lang="en">Functional and inverse-functional. Relates a watch-later list to its owner user. Inverse of hasWatchLaterList.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:label xml:lang="en">has watch later entry</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a watch-later list to its entries.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:label xml:lang="en">entry in watch later list</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a watch-later entry to the list it belongs to. Inverse of hasWatchLaterEntry.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">watch later content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a watch-later entry to the audiovisual content it references.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#isInWatchLaterList -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#isInWatchLaterList">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:label xml:lang="en">is in watch later list</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred inverse-style summary. Relates audiovisual content to the watch-later lists it appears in.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasWatchLaterContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterContent">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterContent"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">has watch later content</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred summary property. Relates a watch-later list to the audiovisual content items in it. Inferred via chain: hasWatchLaterEntry o watchLaterContent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Preference properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasPreference -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreference">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#preferenceOfUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:label xml:lang="en">has preference</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a user to their preference records.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferenceOfUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceOfUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">preference of user</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a preference record to the user who holds it. Inverse of hasPreference.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferredGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferredGenre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#GenrePreference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">preferred genre</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a genre preference record to the genre that is preferred.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferredActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferredActor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActorPreference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">preferred actor</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an actor preference record to the actor that is preferred.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferredDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferredDirector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DirectorPreference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:label xml:lang="en">preferred director</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a director preference record to the director that is preferred.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredGenre">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredGenre"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">has preferred genre</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred user-level summary. Relates a user directly to their preferred genres. Inferred via chain: hasPreference o preferredGenre.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredActor">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredActor"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">has preferred actor</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred user-level summary. Relates a user directly to their preferred actors. Inferred via chain: hasPreference o preferredActor.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasPreferredDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreferredDirector">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasPreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredDirector"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:label xml:lang="en">has preferred director</rdfs:label>
        <rdfs:comment xml:lang="en">Inferred user-level summary. Relates a user directly to their preferred directors. Inferred via chain: hasPreference o preferredDirector.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Recommendation properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasRecommendation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasRecommendation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendationForUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:label xml:lang="en">has recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a user to the recommendations generated for them.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#recommendationForUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendationForUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">recommendation for user</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a recommendation to the user it is intended for. Inverse of hasRecommendation.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#recommendedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendedContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentRecommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">recommended content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a content recommendation to the audiovisual content being recommended.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#recommendedGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendedGenre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#GenreRecommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">recommended genre</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a genre recommendation to the genre being recommended.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#recommendedActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendedActor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActorRecommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">recommended actor</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates an actor recommendation to the actor being recommended.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#basedOnGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#basedOnGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">based on genre</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a recommendation to the genre that motivated it as an explanation property.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#basedOnActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#basedOnActor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">based on actor</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a recommendation to the actor preference that motivated it as an explanation property.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#basedOnDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#basedOnDirector">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Director"/>
        <rdfs:label xml:lang="en">based on director</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a recommendation to the director preference that motivated it as an explanation property.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#generatedFromHistory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#generatedFromHistory">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#historyGeneratedRecommendation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:label xml:lang="en">generated from history</rdfs:label>
        <rdfs:comment xml:lang="en">Required recommendation provenance property. Relates a recommendation to the viewing event(s) that triggered its generation.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#historyGeneratedRecommendation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#historyGeneratedRecommendation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:label xml:lang="en">history generated recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of generatedFromHistory. Relates a viewing event to the recommendations it has generated.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#suggestedContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedContent">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasRecommendation"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#recommendedContent"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">suggested content</rdfs:label>
        <rdfs:comment xml:lang="en">Direct inferred summary of content recommendations for a user. Inferred via chain: hasRecommendation o recommendedContent.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#suggestedGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Genre"/>
        <rdfs:label xml:lang="en">suggested genre</rdfs:label>
        <rdfs:comment xml:lang="en">Direct inferred summary of genre recommendations for a user.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#suggestedActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#suggestedActor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">suggested actor</rdfs:label>
        <rdfs:comment xml:lang="en">Direct inferred summary of actor recommendations for a user.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Rating properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#hasUserRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasUserRating">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:label xml:lang="en">has user rating</rdfs:label>
        <rdfs:comment xml:lang="en">Relates a user to the ratings they have submitted.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#ratingByUser -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingByUser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">rating by user</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a rating to the user who submitted it. Inverse of hasUserRating.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#ratesContent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratesContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/streaming-ontology#hasReceivedRating"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">rates content</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. Relates a rating record to the audiovisual content item being rated.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#hasReceivedRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasReceivedRating">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/review"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:label xml:lang="en">has received rating</rdfs:label>
        <rdfs:comment xml:lang="en">Inverse of ratesContent. Relates audiovisual content to user rating records it has received. Subproperty of schema:review.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- ==================== Property chain: hasActingRole o performedBy → hasActor ==================== -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/streaming-ontology#hasActor">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#hasActingRole"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#performedBy"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- ==================== Shared descriptive properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#entityName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#entityName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">entity name</rdfs:label>
        <rdfs:comment xml:lang="en">At most one preferred local name for a domain entity. Supports application data in addition to rdfs:label.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#description -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#description">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:comment xml:lang="en">Optional free-text description of a domain entity.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#externalIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#externalIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">external identifier</rdfs:label>
        <rdfs:comment xml:lang="en">Optional external identifier (e.g., IMDb ID, DBpedia IRI) for a domain entity.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Person and user properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#userIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#userIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">user identifier</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. A unique identifier string for a user (e.g., username or account ID).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#registrationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#registrationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">registration date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The date and time when the user registered on the platform.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#birthDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#birthDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">birth date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The date of birth of a person.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Content properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#title -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#title">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">title</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The title of an audiovisual content item.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#releaseDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#releaseDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">release date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The original release date of an audiovisual content item.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#contentDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#contentDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/duration"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:label xml:lang="en">content duration</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The runtime duration of an audiovisual content item. Aligned with schema:duration.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#seasonNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#seasonNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:label xml:lang="en">season number</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The ordinal number of a TV season within its series.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#episodeNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#episodeNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:label xml:lang="en">episode number</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The ordinal number of a TV episode within its season.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Acting-role properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#roleName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#roleName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">role name</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The name of the acting role (e.g., character name as billed in the credits).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#characterName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#characterName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">character name</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The name of a fictional or represented character.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#billingOrder -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#billingOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">billing order</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The billing position of the actor in the credits (0 = top-billed).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Availability properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#availabilityStartDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityStartDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">availability start date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The date and time from which the content becomes available on a platform.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#availabilityEndDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityEndDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">availability end date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The date and time at which the content ceases to be available on a platform.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#availabilityUrl -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#availabilityUrl">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">availability URL</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. A deep link URL to the content on the streaming platform.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Viewing-event properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#viewingDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewingDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">viewing date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. The date and time when the viewing event occurred.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#viewingDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#viewingDuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:label xml:lang="en">viewing duration</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. The total duration of the viewing session.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#completionPercentage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#completionPercentage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#PercentageValue"/>
        <rdfs:label xml:lang="en">completion percentage</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. The percentage of the content item watched (0–100 inclusive, at most 2 fractional digits). Design threshold: &gt;= 70.00 = significant viewing; &gt;= 90.00 = completed.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Watch-later properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">added to watch later on</rdfs:label>
        <rdfs:comment xml:lang="en">Functional. The date and time when the content was added to the watch-later list.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#watchLaterPosition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:label xml:lang="en">watch later position</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The ordinal position of an entry within a watch-later list.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Preference properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#preferenceWeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceWeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#NormalizedScore"/>
        <rdfs:label xml:lang="en">preference weight</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. A decimal weight in [0.00, 1.00] representing the strength of the user preference. Maximum two fractional digits.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferenceCreationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceCreationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">preference creation date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The date and time when the preference record was first created.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#preferenceLastUpdated -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceLastUpdated">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">preference last updated</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, optional. The date and time when the preference record was last updated.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Recommendation properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#recommendationScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendationScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#NormalizedScore"/>
        <rdfs:label xml:lang="en">recommendation score</rdfs:label>
        <rdfs:comment xml:lang="en">Required, functional. A decimal confidence/relevance score in [0.00, 1.00] for this recommendation. Maximum two fractional digits.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#creationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#creationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/dateCreated"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">creation date</rdfs:label>
        <rdfs:comment xml:lang="en">Required, functional. The date and time when the recommendation was generated. Subproperty of schema:dateCreated.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#recommendationExplanation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#recommendationExplanation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">recommendation explanation</rdfs:label>
        <rdfs:comment xml:lang="en">Optional. A human-readable explanation of why this recommendation was generated.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- ==================== Rating properties ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#ratingValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/ratingValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/streaming-ontology#RatingValue"/>
        <rdfs:label xml:lang="en">rating value</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. A decimal score in [0.0, 10.0] representing the user&apos;s rating (maximum one fractional digit). Subproperty/alignment of schema:ratingValue.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#ratingDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">rating date</rdfs:label>
        <rdfs:comment xml:lang="en">Functional, exactly one. The date and time when the rating was submitted.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/streaming-ontology#ratingComment -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/streaming-ontology#ratingComment">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">rating comment</rdfs:label>
        <rdfs:comment xml:lang="en">Optional. A free-text comment accompanying the user rating.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- ==================== Custom datatypes ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#NormalizedScore -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/streaming-ontology#NormalizedScore">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.00</xsd:maxInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:fractionDigits>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Normalized Score</rdfs:label>
        <rdfs:comment xml:lang="en">Custom datatype for decimal values in [0.00, 1.00] with a maximum of 2 fractional digits. Used for preferenceWeight and recommendationScore.</rdfs:comment>
    </rdfs:Datatype>



    <!-- http://www.semanticweb.org/streaming-ontology#PercentageValue -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/streaming-ontology#PercentageValue">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.00</xsd:maxInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:fractionDigits>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Percentage Value</rdfs:label>
        <rdfs:comment xml:lang="en">Custom datatype for decimal percentage values in [0.00, 100.00] with a maximum of 2 fractional digits. Used for completionPercentage.</rdfs:comment>
    </rdfs:Datatype>



    <!-- http://www.semanticweb.org/streaming-ontology#RatingValue -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/streaming-ontology#RatingValue">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:maxInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:fractionDigits>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Rating Value</rdfs:label>
        <rdfs:comment xml:lang="en">Custom datatype for decimal rating values in [0.0, 10.0] with a maximum of 1 fractional digit. Used for ratingValue.</rdfs:comment>
    </rdfs:Datatype>



    <!-- ==================== Root domain class ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#DomainEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#DomainEntity">
        <rdfs:label xml:lang="en">Domain Entity</rdfs:label>
        <rdfs:comment xml:lang="en">Root class for all ontology-specific entities. All local classes are subclasses of this class.</rdfs:comment>
    </owl:Class>



    <!-- ==================== External Schema.org classes (declared for use as parents) ==================== -->


    <!-- https://schema.org/Person -->

    <owl:Class rdf:about="https://schema.org/Person">
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Reused as the parent of all person-role classes in this ontology.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/Organization -->

    <owl:Class rdf:about="https://schema.org/Organization">
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent of StreamingPlatform and ProductionCompany.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/Country -->

    <owl:Class rdf:about="https://schema.org/Country">
        <rdfs:label xml:lang="en">Country</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Aligned with ProductionCountry.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/Language -->

    <owl:Class rdf:about="https://schema.org/Language">
        <rdfs:label xml:lang="en">Language</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Aligned with ContentLanguage.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/Review -->

    <owl:Class rdf:about="https://schema.org/Review">
        <rdfs:label xml:lang="en">Review</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent of or alignment for UserRating.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/Movie -->

    <owl:Class rdf:about="https://schema.org/Movie">
        <rdfs:label xml:lang="en">Movie</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent or equivalent concept for so:Movie.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/TVSeries -->

    <owl:Class rdf:about="https://schema.org/TVSeries">
        <rdfs:label xml:lang="en">TVSeries</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent or equivalent concept for so:TVSeries.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/TVSeason -->

    <owl:Class rdf:about="https://schema.org/TVSeason">
        <rdfs:label xml:lang="en">TVSeason</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent or equivalent concept for so:TVSeason.</rdfs:comment>
    </owl:Class>



    <!-- https://schema.org/TVEpisode -->

    <owl:Class rdf:about="https://schema.org/TVEpisode">
        <rdfs:label xml:lang="en">TVEpisode</rdfs:label>
        <rdfs:comment xml:lang="en">External Schema.org class. Parent or equivalent concept for so:TVEpisode.</rdfs:comment>
    </owl:Class>



    <!-- ==================== AudiovisualContent and hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#AudiovisualContent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#AudiovisualContent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Audiovisual Content</rdfs:label>
        <rdfs:comment xml:lang="en">Any audiovisual work available or potentially available through streaming. Root class of the content hierarchy.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Movie -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Movie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Movie"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#releaseDate"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#contentDuration"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Movie</rdfs:label>
        <rdfs:comment xml:lang="en">A feature-length or standalone film available through streaming.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Documentary -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Documentary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:label xml:lang="en">Documentary</rdfs:label>
        <rdfs:comment xml:lang="en">A non-fiction audiovisual work. May overlap with Movie or TVSeries; not declared disjoint from either.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#DocumentaryMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#DocumentaryMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Documentary"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Movie"/>
        <rdfs:label xml:lang="en">Documentary Movie</rdfs:label>
        <rdfs:comment xml:lang="en">A documentary represented as a standalone movie.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#TVSeries -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeries">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVSeries"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeason"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeriesEpisode"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">TV Series</rdfs:label>
        <rdfs:comment xml:lang="en">A television series composed of one or more seasons or episodes.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#DocumentarySeries -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#DocumentarySeries">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Documentary"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
        <rdfs:label xml:lang="en">Documentary Series</rdfs:label>
        <rdfs:comment xml:lang="en">A documentary represented as a television series.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#TVSeason -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeason">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVSeason"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonOfSeries"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#seasonNumber"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasSeasonEpisode"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">TV Season</rdfs:label>
        <rdfs:comment xml:lang="en">A season belonging to a TV series, containing one or more episodes.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#TVEpisode -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#TVEpisode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TVEpisode"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeNumber"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#title"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOfSeason"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#episodeOfSeries"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">TV Episode</rdfs:label>
        <rdfs:comment xml:lang="en">An episode belonging to a TV season or directly to a TV series.</rdfs:comment>
    </owl:Class>



    <!-- ==================== Person hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#User -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#User">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">User</rdfs:label>
        <rdfs:comment xml:lang="en">A registered user of one or more streaming platforms.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Actor -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Actor">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Actor</rdfs:label>
        <rdfs:comment xml:lang="en">A person who performs an acting role in audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#VoiceActor -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#VoiceActor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Actor"/>
        <rdfs:label xml:lang="en">Voice Actor</rdfs:label>
        <rdfs:comment xml:lang="en">An actor who performs a voice-only role in animated or dubbed audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Director -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Director">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Director</rdfs:label>
        <rdfs:comment xml:lang="en">A person who directs audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Producer -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Producer">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Producer</rdfs:label>
        <rdfs:comment xml:lang="en">A person responsible for producing audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Screenwriter -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Screenwriter">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Screenwriter</rdfs:label>
        <rdfs:comment xml:lang="en">A person who writes the screenplay for audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- ==================== Platform, Company, Country, Language, Genre ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#StreamingPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#StreamingPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:label xml:lang="en">Streaming Platform</rdfs:label>
        <rdfs:comment xml:lang="en">A service offering streamed audiovisual content to subscribers. Platform brands (Netflix, Prime Video, Apple TV+) will be represented as individuals of this class using DBpedia resources.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ProductionCompany -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ProductionCompany">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:label xml:lang="en">Production Company</rdfs:label>
        <rdfs:comment xml:lang="en">An organization that produces audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ProductionCountry -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ProductionCountry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Country"/>
        <rdfs:label xml:lang="en">Production Country</rdfs:label>
        <rdfs:comment xml:lang="en">A country associated with the production of audiovisual content, and also used as a geographic reference for content availability regions.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ContentLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Language"/>
        <rdfs:label xml:lang="en">Content Language</rdfs:label>
        <rdfs:comment xml:lang="en">A language used by or available for audiovisual content (original language, audio dubbing, subtitles).</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#Genre -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Genre">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Genre</rdfs:label>
        <rdfs:comment xml:lang="en">A category of audiovisual content defined by narrative form, style, or subject matter (e.g., action, comedy, drama). Aligned with schema:genre.</rdfs:comment>
    </owl:Class>



    <!-- ==================== Character, ActingRole hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#Character -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Character">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:label xml:lang="en">Character</rdfs:label>
        <rdfs:comment xml:lang="en">A fictional or represented character appearing in audiovisual content.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ActingRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ActingRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#roleInContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#performedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#portraysCharacter"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#roleName"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#billingOrder"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Acting Role</rdfs:label>
        <rdfs:comment xml:lang="en">A reified participation node connecting a performer, a character, and an audiovisual content item. Required to capture character name, billing order, and voice/on-screen distinction.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#OnScreenRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#OnScreenRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/streaming-ontology#VoiceRole"/>
        <rdfs:label xml:lang="en">On-Screen Role</rdfs:label>
        <rdfs:comment xml:lang="en">An acting role performed physically on screen by the actor.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#VoiceRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#VoiceRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
        <rdfs:label xml:lang="en">Voice Role</rdfs:label>
        <rdfs:comment xml:lang="en">An acting role performed by voice only (animation, dubbing).</rdfs:comment>
    </owl:Class>



    <!-- ==================== ContentAvailability hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#ContentAvailability -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentAvailability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityOfContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availableOnPlatform"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityStartDate"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityEndDate"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#availabilityUrl"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Content Availability</rdfs:label>
        <rdfs:comment xml:lang="en">A reified record describing the time-bounded availability of an audiovisual content item on a specific streaming platform, optionally restricted to geographic regions.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ActiveAvailability -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ActiveAvailability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/streaming-ontology#ExpiredAvailability"/>
        <rdfs:label xml:lang="en">Active Availability</rdfs:label>
        <rdfs:comment xml:lang="en">A content availability record that is currently active (the current date is between the start and end dates, or there is no end date).</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ExpiredAvailability -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ExpiredAvailability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
        <rdfs:label xml:lang="en">Expired Availability</rdfs:label>
        <rdfs:comment xml:lang="en">A content availability record whose end date has passed; the content is no longer available on that platform.</rdfs:comment>
    </owl:Class>



    <!-- ==================== ViewingEvent hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#ViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedByUser"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewingDate"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#viewingDuration"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Viewing Event</rdfs:label>
        <rdfs:comment xml:lang="en">A single occurrence of a user watching an audiovisual content item, recording date, duration, and completion percentage.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/streaming-ontology#PartialViewingEvent"/>
        <rdfs:label xml:lang="en">Completed Viewing Event</rdfs:label>
        <rdfs:comment xml:lang="en">A viewing event where completionPercentage is at or above 90. Inferred by SWRL rule R5.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#PartialViewingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#PartialViewingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
        <rdfs:label xml:lang="en">Partial Viewing Event</rdfs:label>
        <rdfs:comment xml:lang="en">A viewing event where completionPercentage is below 90. Inferred by SWRL rule R6.</rdfs:comment>
    </owl:Class>



    <!-- ==================== WatchLaterList and WatchLaterEntry ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#WatchLaterList -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterList">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterListOf"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#hasWatchLaterEntry"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Watch Later List</rdfs:label>
        <rdfs:comment xml:lang="en">A user-owned ordered collection of audiovisual content items saved for later viewing.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#WatchLaterEntry -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#addedToWatchLaterOn"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#watchLaterPosition"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#entryInWatchLaterList"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#watchLaterContent"/>
        </owl:hasKey>
        <rdfs:label xml:lang="en">Watch Later Entry</rdfs:label>
        <rdfs:comment xml:lang="en">A dated entry in a watch-later list, linking a specific content item with a timestamp and optional ordering position. Uniquely identified by (entryInWatchLaterList, watchLaterContent).</rdfs:comment>
    </owl:Class>



    <!-- ==================== UserPreference hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#UserPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#UserPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferenceOfUser"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferenceWeight"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferenceCreationDate"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferenceLastUpdated"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">User Preference</rdfs:label>
        <rdfs:comment xml:lang="en">A weighted preference record associated with a user, representing an affinity for a genre, actor, or director.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#GenrePreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#GenrePreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferredGenre"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceOfUser"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredGenre"/>
        </owl:hasKey>
        <rdfs:label xml:lang="en">Genre Preference</rdfs:label>
        <rdfs:comment xml:lang="en">A user preference for a specific genre. Uniquely identified by (preferenceOfUser, preferredGenre).</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ActorPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ActorPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferredActor"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceOfUser"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredActor"/>
        </owl:hasKey>
        <rdfs:label xml:lang="en">Actor Preference</rdfs:label>
        <rdfs:comment xml:lang="en">A user preference for a specific actor. Uniquely identified by (preferenceOfUser, preferredActor).</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#DirectorPreference -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#DirectorPreference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#preferredDirector"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferenceOfUser"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#preferredDirector"/>
        </owl:hasKey>
        <rdfs:label xml:lang="en">Director Preference</rdfs:label>
        <rdfs:comment xml:lang="en">A user preference for a specific director. Uniquely identified by (preferenceOfUser, preferredDirector).</rdfs:comment>
    </owl:Class>



    <!-- ==================== Recommendation hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#Recommendation -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#Recommendation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendationForUser"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendationScore"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#creationDate"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">A recommendation generated for a user, with a confidence score, creation date, and provenance from viewing history or preferences.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ContentRecommendation -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentRecommendation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendedContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Content Recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">A recommendation of a specific audiovisual content item to a user.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#GenreRecommendation -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#GenreRecommendation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendedGenre"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Genre Recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">A recommendation suggesting a specific genre for a user to explore.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ActorRecommendation -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ActorRecommendation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#recommendedActor"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Actor Recommendation</rdfs:label>
        <rdfs:comment xml:lang="en">A recommendation suggesting a specific actor whose content a user may enjoy.</rdfs:comment>
    </owl:Class>



    <!-- ==================== UserRating ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#UserRating -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#UserRating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#DomainEntity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Review"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingDate"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingComment"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
        </owl:hasKey>
        <rdfs:label xml:lang="en">User Rating</rdfs:label>
        <rdfs:comment xml:lang="en">A rating event submitted by a user for a specific audiovisual content item. Uniquely identified by (ratingByUser, ratesContent). Subclass of schema:Review.</rdfs:comment>
    </owl:Class>



    <!-- ==================== User engagement hierarchy ==================== -->


    <!-- http://www.semanticweb.org/streaming-ontology#HighlyEngagedUser -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#HighlyEngagedUser">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">Highly Engaged User</rdfs:label>
        <rdfs:comment xml:lang="en">A user inferred to be highly engaged because they have at least one completed viewing event (completionPercentage &gt;= 90). Inferred by SWRL rule R7.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/streaming-ontology#ContentCompleter -->

    <owl:Class rdf:about="http://www.semanticweb.org/streaming-ontology#ContentCompleter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
        <rdfs:label xml:lang="en">Content Completer</rdfs:label>
        <rdfs:comment xml:lang="en">A user inferred to have completed at least one content item fully. Inferred by SWRL rule R8.</rdfs:comment>
    </owl:Class>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- (Intentionally empty: no domain individuals are asserted in this TBox phase.
         Platform brands such as dbr:Netflix and content, country, language, genre,
         and person individuals will be introduced as ABox data in a later phase
         using DBpedia resource IRIs.) -->



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- 10.1 Disjoint top-level domain concepts -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#StreamingPlatform"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ProductionCompany"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ProductionCountry"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ContentLanguage"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Genre"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Character"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ActingRole"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ContentAvailability"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterList"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#WatchLaterEntry"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#UserPreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Recommendation"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#UserRating"/>
        </owl:members>
    </rdf:Description>

    <!-- 10.2 Content disjointness (Movie, TVSeries, TVSeason, TVEpisode — Documentary excluded) -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#Movie"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeries"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVSeason"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#TVEpisode"/>
        </owl:members>
    </rdf:Description>

    <!-- 10.3 Preference disjointness -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#GenrePreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ActorPreference"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#DirectorPreference"/>
        </owl:members>
    </rdf:Description>

    <!-- 10.4 Recommendation disjointness -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ContentRecommendation"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#GenreRecommendation"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ActorRecommendation"/>
        </owl:members>
    </rdf:Description>

    <!-- 10.5 Role disjointness (declared inline via owl:disjointWith on OnScreenRole) -->

    <!-- 10.6 Viewing-state disjointness (declared inline via owl:disjointWith on CompletedViewingEvent) -->

    <!-- 10.7 Availability-state disjointness (declared inline via owl:disjointWith on ActiveAvailability) -->



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- SWRL Variable declarations -->

    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#u">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#ve">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#c">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#a">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#g">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#d">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#pct">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#rv">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/streaming-ontology#r">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>


    <!-- R1: Infer Preferred Actor From Viewing History -->
    <!-- Body: User(?u) ^ hasViewingEvent(?u,?ve) ^ viewedContent(?ve,?c) ^ completionPercentage(?ve,?pct) ^ swrlb:greaterThanOrEqual(?pct,70.00) ^ hasActor(?c,?a) -->
    <!-- Head: hasPreferredActor(?u,?a) -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user has a viewing event with completion percentage >= 70 and the viewed content features an actor, infer that the actor is a preferred actor for the user. Design assumption: threshold 70.00% signals significant engagement.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infer Preferred Actor From Viewing History</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">70.00</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasActor"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#a"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasPreferredActor"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#a"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R2: Infer Preferred Genre From Viewing History -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user has a viewing event with completion percentage >= 70 and the viewed content belongs to a genre, infer that the genre is preferred by the user. Design assumption: threshold 70.00% signals significant engagement.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infer Preferred Genre From Viewing History</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">70.00</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasGenre"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#g"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasPreferredGenre"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#g"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R3: Infer Preferred Director From Viewing History -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user has a viewing event with completion percentage >= 70 and the viewed content has a director, infer that the director is preferred by the user. Design assumption: threshold 70.00% signals significant engagement.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infer Preferred Director From Viewing History</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">70.00</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasDirector"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#d"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasPreferredDirector"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#d"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R4: Infer Content Recommendation From Positive Rating -->
    <!-- Body: User(?u) ^ hasUserRating(?u,?r) ^ ratesContent(?r,?c) ^ ratingValue(?r,?rv) ^ swrlb:greaterThanOrEqual(?rv,8.0) -->
    <!-- Head: hasWatchedContent(?u,?c) — used to mark the user as having highly rated this content for further downstream recommendation -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user submits a rating of >= 8.0 for a content item, assert that the user has a positive engagement with that content. Design assumption: threshold 8.0 indicates a strongly positive rating.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infer Positive Content Engagement From High Rating</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasUserRating"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#r"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ratesContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#r"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingValue"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#r"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#rv"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#rv"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasWatchedContent"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R5: Classify Completed Viewing Event -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a viewing event has completionPercentage >= 90, classify it as a CompletedViewingEvent. Design assumption: 90% or above constitutes full content completion.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classify Completed Viewing Event</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90.00</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R6: Classify Partial Viewing Event -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a viewing event has completionPercentage strictly less than 90, classify it as a PartialViewingEvent. Design assumption: below 90% the content was not fully completed.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classify Partial Viewing Event</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ViewingEvent"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90.00</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#PartialViewingEvent"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R7: Classify Highly Engaged User -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user has at least one completed viewing event (completionPercentage >= 90), classify the user as a HighlyEngagedUser. Design assumption: completing at least one item signals high platform engagement.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classify Highly Engaged User</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#CompletedViewingEvent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#HighlyEngagedUser"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>


    <!-- R8: Classify Content Completer -->

    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If a user has a viewing event where completionPercentage >= 90 for a content item, classify the user as a ContentCompleter. Design assumption: the same threshold as CompletedViewingEvent (90%) marks full completion.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classify Content Completer</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90.00</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ContentCompleter"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
