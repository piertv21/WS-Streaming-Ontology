    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Recommends a new content (?c2) if the user has completed at least 95% of a content (?c1), and the new content shares both the director and the genre, ensuring thematic continuity.</rdfs:comment>
        <rdfs:label>RecommendContent</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#User"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasViewingEvent"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#viewedContent"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c1"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#completionPercentage"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ve"/>
                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                        <swrl:arguments>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:resource="http://www.semanticweb.org/streaming-ontology#pct"/>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.0</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </swrl:arguments>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasDirector"/>
                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c1"/>
                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#d"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasGenre"/>
                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c1"/>
                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#g"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#AudiovisualContent"/>
                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c2"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom"/>
                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c1"/>
                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#c2"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasDirector"/>
                                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c2"/>
                                                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#d"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#hasGenre"/>
                                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c2"/>
                                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#g"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
