                                                                                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingValue"/>
                                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ur1"/>
                                                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#r1"/>
                                                                                            </rdf:Description>
