                                                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#c1"/>
                                                                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#ur1"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#ratingByUser"/>
                                                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#ur1"/>
                                                                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
