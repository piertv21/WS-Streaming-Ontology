        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/streaming-ontology#suggestedGenre"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/streaming-ontology#u"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/streaming-ontology#g"/>
                    </rdf:Description>
